# Intervals.icu Configuration
# Athlete ID can be found in Intervals.icu URL / Settings (e.g., i123456)
INTERVALS_ATHLETE_ID=iXXXXXX

# API Key generated in Intervals.icu > Settings > Developer Settings
INTERVALS_API_KEY=your_intervals_api_key_here

# TrainingPeaks Athlete ID (visible in your profile URL or auto-detected)
TP_ATHLETE_ID=your_tp_athlete_id_here

# Android ADB & Chrome DevTools Protocol (CDP) settings
# 127.0.0.1:5555 when running locally on phone via Termux ADB loopback
# Or your phone IP (e.g. 192.168.3.64:5555) if running from a PC
ANDROID_ADB_TARGET=127.0.0.1:5555
ANDROID_CDP_PORT=9222

# Telegram Notifications (Optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
